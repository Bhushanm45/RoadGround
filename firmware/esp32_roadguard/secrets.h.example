// ============================================================================
// RoadGuard AI - Private Hardware Wi-Fi & Gateway Configuration
// Copy this file to "secrets.h" in the same folder and enter your credentials.
// "secrets.h" is gitignored and will never be pushed to GitHub.
// ============================================================================

#ifndef SECRETS_H
#define SECRETS_H

// ----------------------------------------------------------------------------
// 1. Phone Hotspot or Local Wi-Fi Credentials
// ----------------------------------------------------------------------------
// CRITICAL: Ensure your phone hotspot AP Band is set to "2.4 GHz Band"
// (ESP32 hardware does NOT support 5 GHz Wi-Fi networks).
const char* WIFI_SSID     = "OPPO K13 5G CDCC";
const char* WIFI_PASSWORD = "your_hotspot_password_here";

// ----------------------------------------------------------------------------
// 2. Laptop Local IPv4 Address & Telemetry API Endpoint
// ----------------------------------------------------------------------------
// DO NOT use "127.0.0.1" or "localhost" - on an ESP32, 127.0.0.1 refers to
// the ESP32 chip itself, NOT your laptop!
//
// Find your laptop's current IP address by running:
//   PowerShell: ipconfig   (Look for 'IPv4 Address' under 'Wireless LAN adapter Wi-Fi')
//   Or check terminal output when starting the backend: py backend/app.py
//
// Example: "http://10.131.244.214:5000/api/telemetry"
const char* BACKEND_URL   = "http://10.131.244.214:5000/api/telemetry";

#endif // SECRETS_H
